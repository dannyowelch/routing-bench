# Copy to .env and fill in. Never commit .env.
# The runner loads .env from the current directory without overriding
# variables that are already set. It does not talk to any particular gateway.

# --- Credential (pick the one your gateway or provider told you to use) ---
# Direct Anthropic API:
# ANTHROPIC_API_KEY=
# Gateway bearer token (Authorization: Bearer). Documented Claude Code variable:
# ANTHROPIC_AUTH_TOKEN=
# Gateway key sent as x-api-key. Documented Claude Code variable:
# ANTHROPIC_API_KEY=

# Base URL of an Anthropic-Messages-compatible gateway. Leave unset to call
# the provider Claude Code is logged into. No trailing path is added here;
# use the base URL your gateway's Claude Code instructions specify.
# ANTHROPIC_BASE_URL=

# Extra request headers, one "Name: Value" pair per line. Claude Code sends
# these on every API request (ANTHROPIC_CUSTOM_HEADERS). Put gateway auth
# or routing headers here when they are not the credential variables above.
# ANTHROPIC_CUSTOM_HEADERS=

# Optional pins for Claude Code's opus / sonnet / haiku aliases. Set these
# when a gateway expects a full model id. See model-config docs.
# ANTHROPIC_DEFAULT_OPUS_MODEL=
# ANTHROPIC_DEFAULT_SONNET_MODEL=
# ANTHROPIC_DEFAULT_HAIKU_MODEL=

# --- Models this benchmark asks Claude Code to use ---
# Defaults are Claude Code family aliases. Override with full ids if you want.
# MODEL_STRONG=opus
# MODEL_MID=sonnet
# MODEL_CHEAP=haiku
# MODEL_ADVISOR=opus

# --- Tags so a gateway log can be filtered ---
# Opt-in. Appended to ANTHROPIC_CUSTOM_HEADERS for each invocation.
# Placeholders: {setup} {task} {role} {run_id} {experiment}
# Use \n between headers. Replace the header names with whatever your gateway
# actually indexes (a metadata header, a trace id, and so on).
BENCHMARK_GATEWAY_HEADERS="X-Benchmark-Setup: {setup}\nX-Benchmark-Task: {task}\nX-Benchmark-Role: {role}\nX-Benchmark-Run-Id: {run_id}\nX-Benchmark-Experiment: {experiment}"

# --- OpenTelemetry (optional; see the README) ---
# CLAUDE_CODE_ENABLE_TELEMETRY=1
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative
# OTEL_METRIC_EXPORT_INTERVAL=5000
# OTEL_LOGS_EXPORT_INTERVAL=5000
# Prompt text stays redacted unless you also set OTEL_LOG_USER_PROMPTS=1.
# Do not set DISABLE_TELEMETRY. That blocks feature-flag fetch, and the
# advisor stays off when feature flags are blocked.
